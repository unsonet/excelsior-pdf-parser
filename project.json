{
  "name": "excelsior-pdf-parser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/excelsior-pdf-parser/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/excelsior-pdf-parser",
        "main": "libs/excelsior-pdf-parser/src/lib/index.ts",
        "tsConfig": "libs/excelsior-pdf-parser/tsconfig.lib.json",
        "assets": ["libs/excelsior-pdf-parser/*.md"]
      }
    },
    "webpack:build": {
      "executor": "@nx/webpack:webpack",
      "options": {
        "outputPath": "dist/libs/excelsior-pdf-parser",
        "main": "libs/excelsior-pdf-parser/src/lib/index.ts",
        "tsConfig": "libs/excelsior-pdf-parser/tsconfig.lib.json",
        "webpackConfig": "libs/excelsior-pdf-parser/webpack.config.js",
        "generatePackageJson": false,
        "optimization": false, 
        "clean": false
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/libs/excelsior-pdf-parser/node/cli.cjs.js"
      }
    },
    "build-all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run excelsior-pdf-parser:build:production",
          "nx run excelsior-pdf-parser:webpack:build"
        ],
        "parallel": false
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "serve-demo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack serve --config libs/excelsior-pdf-parser/webpack.config.demo.js",
        "cwd": "libs/excelsior-pdf-parser"
      }
    }
  }
}